global:
  scrape_interval: 15s
scrape_configs:
  - job_name: 'node'
    static_configs:
      - targets:
        - host.docker.internal:9100
  - job_name: 'wireguard'
    metrics_path: /metrics
    static_configs:
      - targets:
        - host.docker.internal:9586
  - job_name: 'wg-easy'
    metrics_path: /metrics/prometheus
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'wireguard_(.+)'
        target_label: __name__
        replacement: 'wgeasy_$1'
    static_configs:
      - targets:
        - host.docker.internal:51821

{% for ep in endpoints %}
  - job_name: 'blackbox_icmp4_{{ ep.inventory_hostname }}'
    scrape_interval: 5s
    metrics_path: /probe
    params:
      module: [icmp4_{{ ep.inventory_hostname }}]
    static_configs:
      - targets: [1.1.1.1]
        labels:
          ifname: "{{ ep.inventory_hostname }}4"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: instance
        source_labels: [__param_target]
      - target_label: __address__
        replacement: host.docker.internal:9115
{% if ep.peer.address6 is defined %}
  - job_name: 'blackbox_icmp6_{{ ep.inventory_hostname }}'
    scrape_interval: 5s
    metrics_path: /probe
    params:
      module: [icmp6_{{ ep.inventory_hostname }}]
    static_configs:
      - targets: [2606:4700:4700::1111]
        labels:
          ifname: "{{ ep.inventory_hostname }}6"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: instance
        source_labels: [__param_target]
      - target_label: __address__
        replacement: host.docker.internal:9115
{% endif %}
{% endfor %}

